# Copy this file to `.env` for local development, or set these as real
# environment variables in your deployment platform. Never commit a real
# `.env` file — it is already excluded via .gitignore.

# --- Core ---------------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-value

# "true"/"false". Must be false in any environment reachable by the public.
DJANGO_DEBUG=true

# Comma-separated. Required when DJANGO_DEBUG=false.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated, scheme included, only needed when DJANGO_DEBUG=false and
# the site is served over HTTPS behind a domain (Django's CSRF checks
# validate the request's Origin against this list), e.g.:
#   https://thedailydev.example.com
CSRF_TRUSTED_ORIGINS=

# --- Database -------------------------------------------------------------
# Leave unset for local SQLite development. In production, point this at
# PostgreSQL, e.g.:
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# --- Security headers (all default to safe values; override if needed) ----
# Enable once the site is served over HTTPS with a valid certificate.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
# HSTS max-age in seconds. 0 disables HSTS. Only enable once HTTPS is solid
# (a wrong HSTS value can lock browsers out of the site over HTTP for a
# long time), e.g. 31536000 for one year.
DJANGO_SECURE_HSTS_SECONDS=0
# Set to true only when running behind a reverse proxy/load balancer that
# terminates TLS and sets the X-Forwarded-Proto header.
DJANGO_USE_X_FORWARDED_PROTO=false

# --- Logging ----------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO

# --- Email (optional; used only for contact-form admin notifications) -----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=webmaster@localhost
# Leave blank to disable contact-form email notifications entirely (the
# message is still saved and visible in the Django admin either way).
CONTACT_NOTIFICATION_EMAIL=
